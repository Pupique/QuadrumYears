# Absolute path to the RimWorld Mods directory (parent of individual mod folders).
# Copy this file to paths.env and adjust for your install.
#
# Steam (Linux) example:
#   RIMWORLD_MODS_DIR="/home/USER/.steam/steam/steamapps/common/RimWorld/Mods"
# Steam (Windows) example:
#   RIMWORLD_MODS_DIR="C:/Program Files (x86)/Steam/steamapps/common/RimWorld/Mods"

RIMWORLD_MODS_DIR="/path/to/Rimworld/Mods"
